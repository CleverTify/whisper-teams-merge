# OPTIONAL. `docker compose up` works with no .env at all — every setting here
# already has this value as its default in app/config.py. Copy this file to
# .env only when you want to change one of them:
#
#     cp .env.example .env
#
# Hardware is not in here. The app calls torch.cuda.is_available() and picks
# its own backend; the only hardware decision left is whether Docker hands it a
# GPU, and that is the second command in the README, not a setting.

# ---------------------------------------------------------------------------
# Diarization uses pyannote/speaker-diarization-community-1 (CC-BY-4.0 but
# gated). The token's account must accept the terms at:
#   https://huggingface.co/pyannote/speaker-diarization-community-1
#   https://huggingface.co/pyannote/segmentation-3.0
#
# NOT needed when you upload a Teams transcript — speakers come from there.
# ---------------------------------------------------------------------------
HF_TOKEN=

# --- ASR -------------------------------------------------------------------
# auto -> faster-whisper when CUDA is present, whisper.cpp otherwise
BACKEND=auto
WHISPER_MODEL=large-v3
WHISPER_CPP_MODEL=ggml-large-v3.bin
# Never int8 on Blackwell (sm_120): CTranslate2 raises
# CUBLAS_STATUS_NOT_SUPPORTED. config.py overrides it anyway.
COMPUTE_TYPE=float16
BATCH_SIZE=8
BEAM_SIZE=5

# --- languages (single | auto | multi) -------------------------------------
# multi handles code-switching, e.g. a Czech/Slovak meeting.
LANG_MODE=auto
LANGUAGE=
LANG_DOMINANCE=0.85
LID_SAMPLES=30

# --- diarization (ignored when a Teams transcript is supplied) -------------
DIARIZE=true
MIN_SPEAKERS=
MAX_SPEAKERS=
TURN_MERGE_GAP=0.8
SPEAKER_SMOOTH_WORDS=3
MIN_TURN_SECONDS=0.7
BOUNDARY_SNAP_WORDS=3
# Clusters this similar (cosine) are treated as one person. Measured: the same
# voice split into three clusters scored 0.75-0.80; two real speakers scored 0.42.
SPEAKER_MERGE_THRESHOLD=0.60
# pyannote VBx clustering threshold. Ships as 0.6, which over-splits real
# calls; measured on a 59-min 2-person recording: 0.60->5 speakers, 0.75-0.85
# ->3 (stable), 0.95->2 but fuses the two REAL speakers. 0.80 is the safe band.
CLUSTER_THRESHOLD=0.80

# --- local LLM -------------------------------------------------------------
# With a Teams transcript: merges both readings of the audio.
# Without one: cleans up ours. Every returned line is checked against the line
# it replaces and discarded if it drifts — see app/llm.py.
LLM_ENABLED=true
LLM_MODEL=qwen3-8b-instruct
LLM_MODEL_URL=https://huggingface.co/Qwen/Qwen3-8B-GGUF/resolve/main/Qwen3-8B-Q4_K_M.gguf
LLM_WINDOW_SECONDS=90
LLM_TIMEOUT=180
LLM_MAX_LENGTH_RATIO=1.6
LLM_MIN_LENGTH_RATIO=0.5
LLM_MIN_TOKEN_OVERLAP=0.55
# Names, products and jargon Whisper has no prior for, comma-separated. The
# merge may use these spellings to fix a word that is already there;
# llm.screen_term_ok() rejects them as insertions, so a wrong entry costs a
# substitution and cannot invent a sentence. Empty by default on purpose: a
# glossary is your vocabulary, not the app's. Measured ceiling on a 92-minute
# Czech call, with 12 terms hand-picked from that call's own known errors:
# 14.48% -> 14.41% wording error, 10 columns fixed against 3 broken. Real
# (the paired interval clears zero) and very small.
LLM_GLOSSARY=

# --- VAD (WhisperX) --------------------------------------------------------
# How readily a speech region opens and closes. Measured on that same call,
# loosening these to 0.35/0.25 made the transcript worse, not better: missing
# words already outnumber wrong words three to one, and the regions the looser
# setting added were noise rather than speech.
VAD_ONSET=0.500
VAD_OFFSET=0.363
VAD_CHUNK_SIZE=30

# --- on-screen context (video uploads only) --------------------------------
# Needs the "screen" profile above. Audio-only jobs skip every line of this.
SCREEN_ENABLED=true
# Scene-change sensitivity for frame extraction; lower grabs more frames.
SCREEN_SCENE_THRESHOLD=0.02
SCREEN_MAX_FRAMES=600
SCREEN_FRAME_WIDTH=1280
SCREEN_OCR_LANGS=ces+eng
SCREEN_TERMS_PER_WINDOW=20
# Off by design, and measured: across 420 frames of a screen-shared call, OCR
# never once read the words the transcript actually got wrong (docker,
# trojúhelníček, teamsech, appku, kanban). Feeding the merge terms it cannot
# supply is prompt noise. The VLM captions below are the half that works.
SCREEN_TERMS_IN_PROMPT=false
SCREEN_VLM_ENABLED=true
SCREEN_VLM_MODEL=qwen3-vl-8b
SCREEN_VLM_TIMEOUT=180

# --- audio -----------------------------------------------------------------
LOUDNORM=true
HIGHPASS_HZ=70
DENOISE=false

LOG_LEVEL=INFO
